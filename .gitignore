# Local secrets (copy from .env.example)
.env

# Python virtual environment (large; recreate with ./setup.sh)
.venv/

# Python caches / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# OS / editor cruft
.DS_Store
*.swp

# Cached top-down render of the point cloud (regenerated from the .las)
*.topdown.npz
topdown.png

# YOLO / detector weights (large; auto-downloaded or built locally)
*.pt
*.onnx
*.engine
